{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KanFanOS",
  "version": "1.2.1",
  "identifier": "com.kanfanos.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm sidecars && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KanFanOS",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$LOCALDATA/KanFanOS/thumbnails/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/mpv",
      "binaries/ffmpeg",
      "binaries/ffprobe",
      "binaries/qbittorrent"
    ],
    "resources": {
      "binaries/d3dcompiler_43.dll": "d3dcompiler_43.dll",
      "resources/qbittorrent-COPYING.txt": "qbittorrent-COPYING.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
